# --- required ---
APP_PASSWORD=change-me-shared-household-password

# --- LLM backend ---
# anthropic  = Anthropic API key (pay per token)         -> set ANTHROPIC_API_KEY
# claude-cli = headless Claude Code CLI on this machine  -> bills your Claude
#              subscription (Pro/Max); needs `claude` installed + logged in
# grok       = xAI API billed to Grok Build prepaid team -> no key needed if
#              `grok login` OR Hermes Agent xai-oauth is live on this host
#              (reads ~/.grok/auth.json, falls back to ~/.hermes/auth.json).
#              Optional classic key: XAI_API_KEY. Comma chain: claude-cli,grok
LLM_BACKEND=claude-cli,grok
ANTHROPIC_API_KEY=sk-ant-...
XAI_API_KEY=
GROK_MODEL=grok-4
# Prefer Build OIDC prepaid credits over a possibly-capped console API key (default on)
XAI_PREFER_GROK_BUILD_OIDC=1
CLAUDE_CLI_BIN=claude
CLAUDE_CLI_MODEL=
# Reasoning effort per turn (low|medium|high|xhigh|max); empty = CLI default
CLAUDE_CLI_EFFORT=
# Per-turn wall clock for headless claude. 600 when it is the primary brain;
# drop to ~120 only if it is a fallback behind another backend. Give extra
# headroom (900+) when running a deep-reasoning model at high/max effort.
CLAUDE_CLI_TIMEOUT_SECONDS=600

# --- reply verification (adversarial conscience) ---
# When true, replies containing dollar amounts >= $100, percentages,
# recommendations, or deadlines get a second model pass that attacks them for
# hallucinated or inconsistent numbers, overconfidence, and missing caveats.
# A material finding triggers exactly one revision. Set to false to disable.
# Costs 2-3x the model calls on consequential turns (SMS replies are skipped).
VERIFY_REPLIES=true

# --- banking data (pick one or both) ---
# SimpleFIN Bridge read-only access URL (from: python -m bankai.connectors.simplefin claim <token>)
SIMPLEFIN_ACCESS_URL=
# CSV import needs no config — use the dashboard.

# --- notifications ---
NOTIFY_EMAILS=ford.genereaux@gmail.com,spouse@example.com
NOTIFY_FROM=bankai@localhost
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- SMS group thread (Twilio) ---
# The copilot mirrors messages so you + spouse + copilot share one conversation.
TWILIO_ACCOUNT_SID=          # AC... from the Console home page
TWILIO_AUTH_TOKEN=           # Console home page — required (signs inbound webhooks)
# Optional: a standard API key (SK... + secret) is used for sending if set
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=          # the Twilio number you bought, E.164 (+1802...)
# Name:number pairs; names label who said what in the thread
HOUSEHOLD_PHONES=Ford:+18025551234,Sam:+18025555678
# Set to your deployed webhook URL if behind a proxy (else auto-detected)
SMS_PUBLIC_URL=
# Rule notifications also go out as texts when Twilio is configured
NOTIFY_SMS=true

# --- optional ---
# DATABASE_URL=postgresql+psycopg2://user:pass@host/db   (default: sqlite ./bankai.db)
SYNC_INTERVAL_MINUTES=360
# Wake the copilot for a self-directed look when a sync brings new transactions
SYNC_WAKE=true
RULES_INTERVAL_MINUTES=15
# Every N days the copilot emails the household a short check-in (0 disables)
CHECKIN_INTERVAL_DAYS=3
PORT=8300
# Secret for session cookies; auto-derived from APP_PASSWORD if unset
SESSION_SECRET=
