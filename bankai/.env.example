# --- required ---
APP_PASSWORD=change-me-shared-household-password
ANTHROPIC_API_KEY=sk-ant-...

# --- banking data (pick one or both) ---
# SimpleFIN Bridge read-only access URL (from: python -m bankai.connectors.simplefin claim <token>)
SIMPLEFIN_ACCESS_URL=
# CSV import needs no config — use the dashboard.

# --- notifications ---
NOTIFY_EMAILS=ford.genereaux@gmail.com,spouse@example.com
NOTIFY_FROM=bankai@localhost
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- optional ---
# DATABASE_URL=postgresql+psycopg2://user:pass@host/db   (default: sqlite ./bankai.db)
SYNC_INTERVAL_MINUTES=360
RULES_INTERVAL_MINUTES=15
PORT=8300
# Secret for session cookies; auto-derived from APP_PASSWORD if unset
SESSION_SECRET=
